# Skopiuj do .env (cp .env.example .env) i uzupełnij. NIGDY nie commituj .env.

# Token bota z https://discord.com/developers/applications
DISCORD_TOKEN=

# Opcjonalnie: ID serwera deweloperskiego. Komendy slash synchronizują się tam
# natychmiast (globalna synchronizacja potrafi trwać do godziny).
DEV_GUILD_ID=

POSTGRES_USER=methin
POSTGRES_PASSWORD=methin
POSTGRES_DB=methin
POSTGRES_PORT=5432

# Używane, gdy bot/testy działają poza Dockerem (lokalny venv + baza w kontenerze).
# W docker-compose to pole jest nadpisywane adresem z hostem "db".
DATABASE_URL=postgresql+asyncpg://methin:methin@localhost:5432/methin
TEST_DATABASE_URL=postgresql+asyncpg://methin:methin@localhost:5432/methin_test

LOG_LEVEL=INFO
